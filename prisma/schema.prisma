generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pet {
  id                   String               @id @default(cuid())
  householdId          String               @map("household_id")
  household            Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // ペット名はHousehold内だけで重複を避け、別Householdでは同名を許可する。
  name                 String
  species              PetSpecies
  breed                String?
  sex                  PetSex               @default(UNKNOWN)
  birthDate            DateTime?            @map("birth_date") @db.Date
  adoptionDate         DateTime?            @map("adoption_date") @db.Date
  profileImageFileName String?              @map("profile_image_file_name")
  memo                 String?              @db.Text
  // 管理終了後もPet本体を保持し、将来追加する履歴の参照先を維持する。
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  weightRecords        PetWeightRecord[]
  feedingRecords       PetFeedingRecord[]
  waterRecords         PetWaterRecord[]
  walkRecords          PetWalkRecord[]
  litterRecords        PetLitterRecord[]
  records              PetRecord[]
  memoryRecords        PetMemoryRecordPet[]
  dashboardEntries     DashboardPet[]

  @@unique([householdId, name])
  @@index([householdId, createdAt])
  @@index([householdId, species])
  @@map("pets")
}

model PetRecord {
  id                String                      @id @default(cuid())
  petId             String                      @map("pet_id")
  pet               Pet                         @relation(fields: [petId], references: [id], onDelete: Cascade)
  recordType        PetRecordType               @map("record_type")
  // 通常のJST暦日であり、Householdのお世話日境界は適用しない。
  recordDate        DateTime                    @map("record_date") @db.Date
  // 任意の記録時刻はUTC timestampではなく、JST壁時計の0:00からの分数で保持する。
  recordTimeMinutes Int?                        @map("record_time_minutes") @db.SmallInt
  title             String
  memo              String?                     @db.Text
  searchText        String                      @map("search_text") @db.Text
  createdByUserId   String?                     @map("created_by_user_id")
  createdBy         User?                       @relation("PetRecordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  healthDetail      PetHealthRecordDetail?
  medicalDetail     PetMedicalVisitDetail?
  medicationDetail  PetMedicationRecordDetail?
  vaccinationDetail PetVaccinationRecordDetail?
  memoryDetail      PetMemoryRecordDetail?

  @@index([petId, recordDate, recordTimeMinutes, createdAt])
  @@index([petId, recordType, recordDate])
  @@map("pet_records")
}

model PetHealthRecordDetail {
  petRecordId      String                   @id @map("pet_record_id")
  petRecord        PetRecord                @relation(fields: [petRecordId], references: [id], onDelete: Cascade)
  overallCondition HealthOverallCondition   @map("overall_condition")
  appetite         HealthAmountCondition
  activityLevel    HealthAmountCondition    @map("activity_level")
  stoolCondition   HealthExcretionCondition @map("stool_condition")
  urineCondition   HealthExcretionCondition @map("urine_condition")
  symptoms         HealthSymptom[]          @default([])

  @@map("pet_health_record_details")
}

model PetMedicalVisitDetail {
  petRecordId            String    @id @map("pet_record_id")
  petRecord              PetRecord @relation(fields: [petRecordId], references: [id], onDelete: Cascade)
  hospitalName           String?   @map("hospital_name")
  reason                 String    @db.Text
  diagnosis              String?   @db.Text
  examination            String?   @db.Text
  treatment              String?   @db.Text
  // 通院時に病院で処方された薬と指示であり、実際の投薬履歴とは分離する。
  medication             String?   @db.Text
  medicationInstructions String?   @map("medication_instructions") @db.Text
  nextVisitDate          DateTime? @map("next_visit_date") @db.Date
  consultationFee        Decimal?  @map("consultation_fee") @db.Decimal(10, 0)

  @@index([nextVisitDate])
  @@map("pet_medical_visit_details")
}

model PetMedicationRecordDetail {
  petRecordId    String    @id @map("pet_record_id")
  petRecord      PetRecord @relation(fields: [petRecordId], references: [id], onDelete: Cascade)
  medicationName String    @map("medication_name") @db.VarChar(200)
  // 錠数、容量、滴数など単位を含む自由な投与量を保持する。
  dosage         String?   @db.VarChar(100)

  @@map("pet_medication_record_details")
}

model PetVaccinationRecordDetail {
  petRecordId  String    @id @map("pet_record_id")
  petRecord    PetRecord @relation(fields: [petRecordId], references: [id], onDelete: Cascade)
  vaccineName  String    @map("vaccine_name") @db.VarChar(200)
  hospitalName String?   @map("hospital_name") @db.VarChar(200)
  nextDueDate  DateTime? @map("next_due_date") @db.Date

  @@index([nextDueDate])
  @@map("pet_vaccination_record_details")
}

model PetMemoryRecordDetail {
  petRecordId String                 @id @map("pet_record_id")
  petRecord   PetRecord              @relation(fields: [petRecordId], references: [id], onDelete: Cascade)
  tags        String[]               @default([])
  searchTags  String[]               @default([]) @map("search_tags")
  isFavorite  Boolean                @default(false) @map("is_favorite")
  images      PetMemoryRecordImage[]
  pets        PetMemoryRecordPet[]

  @@index([isFavorite])
  @@index([searchTags], type: Gin)
  @@map("pet_memory_record_details")
}

model PetMemoryRecordPet {
  petRecordId  String                @map("pet_record_id")
  petId        String                @map("pet_id")
  sortOrder    Int                   @default(0) @map("sort_order")
  memoryRecord PetMemoryRecordDetail @relation(fields: [petRecordId], references: [petRecordId], onDelete: Cascade)
  pet          Pet                   @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@id([petRecordId, petId])
  @@index([petId])
  @@map("pet_memory_record_pets")
}

model PetMemoryRecordImage {
  id             String                @id @default(cuid())
  memoryRecordId String                @map("memory_record_id")
  memoryRecord   PetMemoryRecordDetail @relation(fields: [memoryRecordId], references: [petRecordId], onDelete: Cascade)
  fileName       String                @map("file_name")
  sortOrder      Int                   @default(0) @map("sort_order")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@unique([memoryRecordId, sortOrder])
  @@map("pet_memory_record_images")
}

enum PetRecordType {
  HEALTH
  MEDICAL
  MEDICATION
  VACCINATION
  MEMORY
}

model PetWeightRecord {
  id         String   @id @default(cuid())
  petId      String   @map("pet_id")
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  recordDate DateTime @map("record_date") @db.Date
  weightKg   Decimal  @map("weight_kg") @db.Decimal(5, 2)
  memo       String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Petの体重は暦日単位で管理し、同じPetには1日1件だけ保存する。
  @@unique([petId, recordDate])
  @@index([recordDate])
  @@map("pet_weight_records")
}

model PetFeedingRecord {
  id              String   @id @default(cuid())
  petId           String   @map("pet_id")
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  // 記録時点のHousehold日替わり時刻で確定したお世話日。設定変更では再計算しない。
  recordDate      DateTime @map("record_date") @db.Date
  fedAt           DateTime @map("fed_at")
  memo            String?  @db.VarChar(500)
  createdByUserId String?  @map("created_by_user_id")
  createdBy       User?    @relation("PetFeedingRecordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Pet Careはイベント履歴のため、同じPet・同じお世話日の複数記録を許可する。
  @@index([petId, recordDate, fedAt])
  @@index([createdByUserId])
  @@map("pet_feeding_records")
}

model PetWaterRecord {
  id              String         @id @default(cuid())
  petId           String         @map("pet_id")
  pet             Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  // 記録時点のHousehold日替わり時刻で確定したお世話日。設定変更では再計算しない。
  recordDate      DateTime       @map("record_date") @db.Date
  caredAt         DateTime       @map("cared_at")
  action          PetWaterAction
  memo            String?        @db.VarChar(500)
  createdByUserId String?        @map("created_by_user_id")
  createdBy       User?          @relation("PetWaterRecordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Pet Careはイベント履歴のため、同じPet・同じお世話日の複数記録を許可する。
  @@index([petId, recordDate, caredAt])
  @@index([createdByUserId])
  @@map("pet_water_records")
}

enum PetWaterAction {
  REPLACED
  REFILLED
}

model PetWalkRecord {
  id              String   @id @default(cuid())
  petId           String   @map("pet_id")
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  // 記録時点のHousehold日替わり時刻で確定し、設定変更では再計算しない。
  recordDate      DateTime @map("record_date") @db.Date
  startedAt       DateTime @map("started_at")
  durationMinutes Int?     @map("duration_minutes")
  distanceMeters  Int?     @map("distance_meters")
  memo            String?  @db.VarChar(500)
  createdByUserId String?  @map("created_by_user_id")
  createdBy       User?    @relation("PetWalkRecordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // DOGの散歩はイベント履歴のため、同じPet・同じお世話日の複数記録を許可する。
  @@index([petId, recordDate, startedAt])
  @@index([createdByUserId])
  @@map("pet_walk_records")
}

model PetLitterRecord {
  id              String          @id @default(cuid())
  petId           String          @map("pet_id")
  pet             Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  // 記録時点のHousehold日替わり時刻で確定し、設定変更では再計算しない。
  recordDate      DateTime        @map("record_date") @db.Date
  occurredAt      DateTime        @map("occurred_at")
  action          PetLitterAction
  memo            String?         @db.VarChar(500)
  createdByUserId String?         @map("created_by_user_id")
  createdBy       User?           @relation("PetLitterRecordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // CATの猫トイレはイベント履歴のため、同じPet・同じお世話日の複数記録を許可する。
  @@index([petId, recordDate, occurredAt])
  @@index([createdByUserId])
  @@map("pet_litter_records")
}

enum PetLitterAction {
  URINATION
  DEFECATION
  BOTH
  CLEANED
}

enum PetSpecies {
  DOG
  CAT
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

model AppSetting {
  id                         String         @id @default(cuid())
  userId                     String?        @map("user_id")
  householdId                String?        @map("household_id")
  user                       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  household                  Household?     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dashboardBoardCount        Int            @default(6)
  recordTimelineDefaultScope String         @default("household")
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  dashboardPets              DashboardPet[]

  @@unique([userId, householdId])
  @@map("app_settings")
}

model DashboardPet {
  id        String     @id @default(cuid())
  settingId String
  setting   AppSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  petId     String
  pet       Pet        @relation(fields: [petId], references: [id], onDelete: Cascade)
  // 設定画面で選ばれた順序を保持し、Petダッシュボード表示の優先順に使う。
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([settingId, petId])
  @@index([petId])
  @@map("dashboard_pets")
}

model User {
  id                          String                  @id @default(cuid())
  name                        String?
  email                       String?                 @unique
  emailVerified               DateTime?               @map("email_verified")
  image                       String?
  appRole                     AppRole                 @default(USER) @map("app_role")
  accessStatus                UserAccessStatus        @default(ACTIVE) @map("access_status")
  suspendedAt                 DateTime?               @map("suspended_at")
  suspendedByUserId           String?                 @map("suspended_by_user_id")
  suspensionReason            String?                 @map("suspension_reason") @db.VarChar(500)
  accounts                    Account[]
  sessions                    Session[]
  memberships                 HouseholdMember[]
  appSettings                 AppSetting[]
  createdHouseholdInvitations HouseholdInvitation[]   @relation("HouseholdInvitationCreator")
  createdPetRecords           PetRecord[]             @relation("PetRecordCreator")
  createdPetFeedingRecords    PetFeedingRecord[]      @relation("PetFeedingRecordCreator")
  createdPetWaterRecords      PetWaterRecord[]        @relation("PetWaterRecordCreator")
  createdPetWalkRecords       PetWalkRecord[]         @relation("PetWalkRecordCreator")
  createdPetLitterRecords     PetLitterRecord[]       @relation("PetLitterRecordCreator")
  createdSavedMemoryTags      SavedMemoryTag[]        @relation("SavedMemoryTagCreator")
  householdActivities         HouseholdActivity[]     @relation("HouseholdActivityActor")
  suspendedBy                 User?                   @relation("UserCurrentSuspensionActor", fields: [suspendedByUserId], references: [id], onDelete: SetNull)
  suspendedUsers              User[]                  @relation("UserCurrentSuspensionActor")
  performedUserAccessActions  UserAccessAction[]      @relation("UserAccessActionActor")
  receivedUserAccessActions   UserAccessAction[]      @relation("UserAccessActionTarget")
  contactInquiries            ContactInquiry[]        @relation("ContactInquiryUser")
  assignedContactInquiries    ContactInquiry[]        @relation("ContactInquiryAssignedAdmin")
  contactInquiryMessages      ContactInquiryMessage[] @relation("ContactInquiryMessageSender")
  createdAt                   DateTime                @default(now()) @map("created_at")
  updatedAt                   DateTime                @updatedAt @map("updated_at")

  @@index([accessStatus])
  @@index([suspendedByUserId])
  @@map("users")
}

model UserAccessAction {
  id                   String               @id @default(cuid())
  actionType           UserAccessActionType @map("action_type")
  actorUserId          String?              @map("actor_user_id")
  actorUserIdSnapshot  String               @map("actor_user_id_snapshot")
  actorNameSnapshot    String               @map("actor_name_snapshot")
  targetUserId         String?              @map("target_user_id")
  targetUserIdSnapshot String               @map("target_user_id_snapshot")
  targetNameSnapshot   String               @map("target_name_snapshot")
  reason               String?              @db.VarChar(500)
  createdAt            DateTime             @default(now()) @map("created_at")
  actor                User?                @relation("UserAccessActionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target               User?                @relation("UserAccessActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("user_access_actions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Household {
  id                    String                @id @default(cuid())
  name                  String
  isDemo                Boolean               @default(false) @map("is_demo")
  // JSTの0時からの分数。Pet Careが共有するHousehold固有のお世話日境界として扱う。
  careDayStartMinutes   Int                   @default(0) @map("care_day_start_minutes")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  // 業務更新と同じtransactionで増分し、SSEを受け取れないクライアントがpollで変更を検出する。
  // actor列は直近の更新元を保持し、クライアント側が自己更新かどうかを判定できるようにする。
  realtimeRevision      BigInt                @default(0) @map("realtime_revision")
  realtimeActorClientId String?               @map("realtime_actor_client_id") @db.VarChar(128)
  realtimeActorUserId   String?               @map("realtime_actor_user_id")
  members               HouseholdMember[]
  pets                  Pet[]
  appSettings           AppSetting[]
  invitations           HouseholdInvitation[]
  savedMemoryTags       SavedMemoryTag[]
  activities            HouseholdActivity[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String        @map("household_id")
  userId      String        @map("user_id")
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model HouseholdInvitation {
  id              String    @id @default(cuid())
  householdId     String    @map("household_id")
  createdByUserId String?   @map("created_by_user_id")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("HouseholdInvitationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId, createdAt])
  @@map("household_invitations")
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AppRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserAccessStatus {
  ACTIVE
  SUSPENDED
}

enum UserAccessActionType {
  SUSPENDED
  RESTORED
}

model HouseholdActivity {
  id                 String                    @id @default(cuid())
  householdId        String                    @map("household_id")
  actorUserId        String?                   @map("actor_user_id")
  actorNameSnapshot  String                    @map("actor_name_snapshot")
  eventType          HouseholdActivityEvent    @map("event_type")
  category           HouseholdActivityCategory
  targetType         String?                   @map("target_type")
  targetId           String?                   @map("target_id")
  targetNameSnapshot String?                   @map("target_name_snapshot")
  details            Json?
  createdAt          DateTime                  @default(now()) @map("created_at")
  household          Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor              User?                     @relation("HouseholdActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt, id])
  @@index([householdId, category, createdAt, id])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("household_activities")
}

enum HouseholdActivityCategory {
  CARE_RECORD
  MEMBER
  GROUP_SETTING
}

enum HouseholdActivityEvent {
  HOUSEHOLD_NAME_UPDATED
  INVITATION_CREATED
  INVITATION_REVOKED
  MEMBER_JOINED
  MEMBER_ROLE_UPDATED
  MEMBER_REMOVED
  MEMBER_LEFT
  OWNERSHIP_TRANSFERRED_AND_LEFT
  PET_WEIGHT_CREATED
  PET_WEIGHT_UPDATED
  PET_WEIGHT_DELETED
  PET_FEEDING_CREATED
  PET_FEEDING_UPDATED
  PET_FEEDING_DELETED
  PET_WATER_CREATED
  PET_WATER_UPDATED
  PET_WATER_DELETED
  PET_WALK_CREATED
  PET_WALK_UPDATED
  PET_WALK_DELETED
  PET_LITTER_CREATED
  PET_LITTER_UPDATED
  PET_LITTER_DELETED
  PET_HEALTH_RECORD_CREATED
  PET_HEALTH_RECORD_UPDATED
  PET_HEALTH_RECORD_DELETED
  PET_MEDICAL_RECORD_CREATED
  PET_MEDICAL_RECORD_UPDATED
  PET_MEDICAL_RECORD_DELETED
  PET_MEDICATION_RECORD_CREATED
  PET_MEDICATION_RECORD_UPDATED
  PET_MEDICATION_RECORD_DELETED
  PET_VACCINATION_RECORD_CREATED
  PET_VACCINATION_RECORD_UPDATED
  PET_VACCINATION_RECORD_DELETED
  PET_MEMORY_RECORD_CREATED
  PET_MEMORY_RECORD_UPDATED
  PET_MEMORY_RECORD_DELETED
}

model ContactInquiry {
  id                        String                  @id @default(cuid())
  publicId                  String                  @unique @map("public_id")
  userId                    String?                 @map("user_id")
  userIdSnapshot            String                  @map("user_id_snapshot")
  userNameSnapshot          String                  @map("user_name_snapshot")
  userEmailSnapshot         String?                 @map("user_email_snapshot")
  category                  ContactInquiryCategory
  subject                   String                  @db.VarChar(100)
  searchText                String                  @map("search_text") @db.Text
  status                    ContactInquiryStatus    @default(OPEN)
  sourcePath                String?                 @map("source_path") @db.VarChar(300)
  errorId                   String?                 @map("error_id") @db.VarChar(128)
  assignedAdminUserId       String?                 @map("assigned_admin_user_id")
  assignedAdminNameSnapshot String?                 @map("assigned_admin_name_snapshot")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  resolvedAt                DateTime?               @map("resolved_at")
  closedAt                  DateTime?               @map("closed_at")
  // Household同期とは独立したrevision。問い合わせ単位の認可と再取得にだけ使用する。
  realtimeRevision          BigInt                  @default(0) @map("realtime_revision")
  realtimeActorClientId     String?                 @map("realtime_actor_client_id") @db.VarChar(128)
  realtimeActorUserId       String?                 @map("realtime_actor_user_id")
  user                      User?                   @relation("ContactInquiryUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdmin             User?                   @relation("ContactInquiryAssignedAdmin", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  messages                  ContactInquiryMessage[]

  @@index([status, updatedAt, id])
  @@index([userId, updatedAt, id])
  @@index([category, updatedAt, id])
  @@index([assignedAdminUserId, updatedAt, id])
  @@index([updatedAt, id])
  @@map("contact_inquiries")
}

model ContactInquiryMessage {
  id                   String            @id @default(cuid())
  inquiryId            String            @map("inquiry_id")
  senderType           ContactSenderType @map("sender_type")
  senderUserId         String?           @map("sender_user_id")
  senderUserIdSnapshot String            @map("sender_user_id_snapshot")
  senderNameSnapshot   String            @map("sender_name_snapshot")
  body                 String            @db.Text
  createdAt            DateTime          @default(now()) @map("created_at")
  inquiry              ContactInquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderUser           User?             @relation("ContactInquiryMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([inquiryId, createdAt, id])
  @@index([senderUserId])
  @@map("contact_inquiry_messages")
}

enum ContactInquiryCategory {
  BUG
  HOW_TO
  FEATURE_REQUEST
  ACCOUNT
  OTHER
}

enum ContactInquiryStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum ContactSenderType {
  USER
  ADMIN
}

model SavedMemoryTag {
  id              String    @id @default(cuid())
  householdId     String    @map("household_id")
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name            String
  normalizedName  String    @map("normalized_name")
  createdByUserId String?   @map("created_by_user_id")
  createdBy       User?     @relation("SavedMemoryTagCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([householdId, normalizedName])
  @@index([householdId, createdAt])
  @@index([createdByUserId])
  @@map("saved_memory_tags")
}

